---
pagination:
  data: site.languages
  size: 1
  alias: lang
permalink: "{{ 'en/' if lang == 'en' }}index.html"
---
<!doctype html>
<html lang="{{ lang }}">
  <head>
    <meta charset="utf-8" />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-164LRX85PJ"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-164LRX85PJ');
    </script>
    <meta name="viewport" content="width=device-width,initial-scale=1" />

    <title>
      {{ t(
        "Accessity — Χαρτογράφηση & βελτίωση αστικής προσβασιμότητας",
        "Accessity — Urban Accessibility Data Platform"
      ) }}
    </title>

    <meta
      name="description"
      content="{{ t(
        'Η Accessity μετατρέπει παρατηρήσεις σε δομημένα δεδομένα για πιο προσβάσιμες πόλεις.',
        'Accessity turns accessibility observations into structured data that supports inclusive cities.'
      ) }}"
    />

    <link rel="icon" href="{{ rootPrefix }}assets/logo.v2.png" type="image/png" />

    {% include "partials/alternates.njk" %}

    <meta name="robots" content="index,follow" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:wght@600;700&family=Source+Sans+3:wght@400;600;700&display=swap"
      rel="stylesheet"
    />

    <meta name="theme-color" content="#3b0db5" />
    <meta name="color-scheme" content="light" />
    <link rel="stylesheet" href="{{ rootPrefix }}assets/styles.v2.css" />
  </head>

  <body>
    <a href="#main" class="skip-link">
      {{ t("Μετάβαση στο περιεχόμενο", "Skip to content") }}
    </a>

    <header id="top">
      <div class="wrap nav-bar">
        <a class="brand" href="#top" aria-label="Accessity">
          <img class="brand-mark" src="{{ rootPrefix }}assets/logo.v2.png" alt="" />
          <span class="brand-text">Accessity</span>
        </a>
        <nav aria-label="Main navigation">
          <a href="#about">{{ t("Τι είναι", "About") }}</a>
          <a href="#how">
            {{ t("Πώς λειτουργεί", "How it works") }}
          </a>
          <a href="#partners">
            {{ t("Για δήμους", "For cities") }}
          </a>
          <a href="#contact">
            {{ t("Συμμετοχή", "Get involved") }}
          </a>
          <a href="blog.html">{{ t("Νέα", "News") }}</a>
        </nav>
        <div class="nav-actions">
          <a class="btn btn-primary" href="#contact">
            {{ t("Επικοινώνησε", "Contact") }}
          </a>
          {% include "partials/lang-switch.njk" %}
        </div>
      </div>
    </header>

    <main id="main" class="wrap" tabindex="-1">
      <section class="hero" aria-labelledby="hero-title">
        <div>
          <p class="eyebrow">
            {{ t("Πρωτοβουλία αστικής προσβασιμότητας", "Urban accessibility initiative") }}
          </p>
          <h1 id="hero-title">
            {{ t(
              "Δίνουμε ορατότητα στην αστική προσβασιμότητα",
              "We give visibility to urban accessibility"
            ) }}
          </h1>
          <p class="lead">
            {{ t(
              "Η Accessity μετατρέπει παρατηρήσεις της καθημερινότητας σε δομημένα δεδομένα που βοηθούν τις πόλεις να γίνουν πιο προσβάσιμες.",
              "Accessity turns everyday observations into structured data that helps cities become more accessible."
            ) }}
          </p>
          <p class="impact">
            {{ t(
              "Βελτιώνει την καθημερινότητα ΑμεΑ, ηλικιωμένων και γονέων με καρότσια, προσφέροντας ασφάλεια, αυτονομία και αξιοπρέπεια.",
              "Improves daily mobility for people with disabilities, older adults, and parents with strollers by supporting safety, independence, and dignity."
            ) }}
          </p>
          <div class="hero-actions">
            <a class="btn btn-primary" href="#contact">
              {{ t("Ξεκίνα συνεργασία", "Start collaborating") }}
            </a>
            <a class="btn btn-secondary" href="#how">
              {{ t("Δες τη διαδικασία", "See the process") }}
            </a>
          </div>
          <div class="hero-metrics">
            <div class="metric">
              <span class="metric-number">3</span>
              <span class="metric-label">
                {{ t("βασικές κατηγορίες δεδομένων", "core data categories") }}
              </span>
            </div>
            <div class="metric">
              <span class="metric-number">100%</span>
              <span class="metric-label">
                {{ t("διαφανής μεθοδολογία", "transparent methodology") }}
              </span>
            </div>
            <div class="metric">
              <span class="metric-number">24/7</span>
              <span class="metric-label">
                {{ t("συλλογή από την κοινότητα", "community-powered collection") }}
              </span>
            </div>
          </div>
        </div>
        <div class="card">
          <h2>{{ t("Τι είναι η Accessity", "What is Accessity") }}</h2>
          <p>
            {{ t(
              "Μια πλατφόρμα που οργανώνει δεδομένα προσβασιμότητας σε μορφή που μπορούν να αξιοποιήσουν πολίτες, δήμοι και φορείς.",
              "A platform that organizes accessibility data in a format that citizens, municipalities, and organizations can use."
            ) }}
          </p>
          <ul class="checklist">
            <li>{{ t("Δομημένη καταγραφή εμποδίων", "Structured barrier reporting") }}</li>
            <li>{{ t("Σαφείς κατηγορίες και σοβαρότητα", "Clear categories and severity") }}</li>
            <li>{{ t("Δεδομένα έτοιμα για δράση", "Action-ready datasets") }}</li>
          </ul>
        </div>
      </section>

      <section id="higgs" aria-labelledby="higgs-title">
        <article class="card higgs-card">
          <div class="higgs-layout">
            <div class="higgs-copy">
              <h2 id="higgs-title">
                {{ t(
                  "Η Accessity συμμετέχει στο πρόγραμμα Incubator του HIGGS",
                  "Accessity participates in the HIGGS Incubator program"
                ) }}
              </h2>
              <p>
                {{ t(
                  "Είμαστε στην ευχάριστη θέση να ανακοινώσουμε τη συμμετοχή μας στον τρέχοντα κύκλο του προγράμματος Incubator του HIGGS! Στην διάρκεια του προγράμματος, εστιάζουμε στην υιοθέτηση καλών πρακτικών στον τρόπο λειτουργίας και επικοινωνίας μας και στην ενίσχυση της διαφάνειας και του κοινωνικού μας αποτυπώματος.",
                  "We are pleased to announce our participation in the current cycle of the HIGGS Incubator program. During the program, we focus on adopting good practices in the way we operate and communicate, and on strengthening our transparency and social impact."
                ) }}
              </p>
              <p>
                {{ t(
                  "Εξίσου σημαντική είναι η συνεργασία με άλλες ομάδες και φορείς του προγράμματος και όχι μόνο. Ανταλλάσσουμε εμπειρία και ιδέες, δοκιμάζουμε και κρατάμε ό,τι λειτουργεί στην πράξη.",
                  "Equally important is collaboration with other teams and organizations in the program and beyond. We exchange experience and ideas, we test, and we keep what works in practice."
                ) }}
              </p>
              <p>
                {% if lang == "en" %}
                <strong>HIGGS (Higher Incubator Giving Growth &amp; Sustainability)</strong>
                supports organizations and social enterprises through education,
                consulting, and networking for sustainable development and
                strengthening their social impact.
                {% else %}
                Το
                <strong>HIGGS (Higher Incubator Giving Growth &amp; Sustainability)</strong>
                στηρίζει οργανώσεις και κοινωνικές επιχειρήσεις με εκπαίδευση,
                συμβουλευτική και δικτύωση για βιώσιμη ανάπτυξη και ενίσχυση του
                κοινωνικού τους αντίκτυπου.
                {% endif %}
              </p>
              <p>
                {{ t(
                  "Ευχαριστούμε θερμά το HIGGS για τη φιλοξενία της ομάδας μας στο πρόγραμμα και αναμένουμε να αξιοποιήσουμε στο έπακρο αυτή την εμπειρία για να προωθήσουμε την αποστολή μας για πιο προσβάσιμες πόλεις.",
                  "We warmly thank HIGGS for hosting our team in the program, and we look forward to making the most of this experience to advance our mission for more accessible cities."
                ) }}
              </p>
              <a
                href="https://www.higgs3.org/"
                target="_blank"
                rel="noopener noreferrer"
              >
                {{ t("Μάθε περισσότερα για το HIGGS →", "Learn more about HIGGS →") }}
              </a>
            </div>
            <div class="higgs-visual" aria-hidden="true">
              <div class="higgs-badge">
                <div class="higgs-badge__half higgs-badge__half--accessity">
                  <img src="{{ rootPrefix }}assets/logo.v2.png" alt="" loading="lazy" />
                </div>
                <div class="higgs-badge__half higgs-badge__half--higgs">
                  <img src="{{ rootPrefix }}assets/higgs-logo.png" alt="" loading="lazy" />
                </div>
                <div class="higgs-badge__divider"></div>
                <div class="higgs-badge__seal">
                  <span class="higgs-badge__plus">+</span>
                </div>
              </div>
            </div>
          </div>
        </article>
      </section>

      <section id="about" aria-labelledby="about-title">
        <p class="eyebrow">{{ t("Τι καταγράφουμε", "What we capture") }}</p>
        <h2 id="about-title">{{ t("Δεδομένα με νόημα", "Meaningful data") }}</h2>
        <p>
          {{ t(
            "Καταγράφουμε εμπόδια, λύσεις και επίπεδα προσβασιμότητας ώστε κάθε σημείο στον χάρτη να οδηγεί σε δράση.",
            "We document barriers, solutions, and accessibility levels so each map point leads to action."
          ) }}
        </p>
        <div class="card-grid">
          <article class="card">
            <h3>{{ t("Εμπόδια", "Barriers") }}</h3>
            <p>
              {{ t(
                "Σπασμένα πεζοδρόμια, έλλειψη ραμπών, στενές είσοδοι και προσωρινά εμπόδια.",
                "Broken sidewalks, missing ramps, narrow entrances, and temporary obstacles."
              ) }}
            </p>
            <ul class="checklist">
              <li>{{ t("Τοποθεσία", "Location") }}</li>
              <li>{{ t("Κρισιμότητα", "Severity") }}</li>
              <li>{{ t("Ημερομηνία", "Timestamp") }}</li>
            </ul>
          </article>
          <article class="card">
            <h3>{{ t("Λύσεις", "Solutions") }}</h3>
            <p>
              {{ t(
                "Σημεία που λειτουργούν σωστά: ράμπες, περάσματα, διαθέσιμες τουαλέτες.",
                "Places that work well: ramps, crossings, accessible toilets."
              ) }}
            </p>
            <ul class="checklist">
              <li>{{ t("Θετικά παραδείγματα", "Positive examples") }}</li>
              <li>{{ t("Πιστοποίηση", "Verification") }}</li>
              <li>{{ t("Συνεχής ενημέρωση", "Ongoing updates") }}</li>
            </ul>
          </article>
          <article class="card">
            <h3>{{ t("Κατάσταση", "Accessibility level") }}</h3>
            <p>
              {{ t(
                "Κατηγορίες που δείχνουν το επίπεδο προσβασιμότητας ενός σημείου ή διαδρομής.",
                "Categories that show the accessibility level of a location or route."
              ) }}
            </p>
            <ul class="checklist">
              <li>{{ t("Πλήρης πρόσβαση", "Full access") }}</li>
              <li>{{ t("Μερική πρόσβαση", "Partial access") }}</li>
              <li>{{ t("Ανύπαρκτη πρόσβαση", "No access") }}</li>
            </ul>
          </article>
        </div>
      </section>

      <section id="how" aria-labelledby="how-title">
        <p class="eyebrow">{{ t("Πώς λειτουργεί", "How it works") }}</p>
        <h2 id="how-title">{{ t("Σαφή βήματα", "Clear steps") }}</h2>
        <p>
          {{ t(
            "Κάθε καταγραφή καταλήγει σε χρήσιμη πληροφορία για την κοινότητα και τους ενδιαφερόμενους φορείς.",
            "Each entry becomes useful information for the community and, later, for the relevant stakeholders."
          ) }}
        </p>
        <ol class="steps">
          <li class="step">
            <span class="step-title">{{ t("Καταγραφή", "Capture") }}</span>
            <p>
              {{ t(
                "Οι πολίτες αξιολογούν την προσβασιμότητα ενός σημείου ενδιαφέροντος (κτίριο, πεζοδρόμιο, δημόσιος χώρος), καταγράφουν τυχόν εμπόδια που συναντούν και αφήνουν σχόλια ή προτάσεις για βελτίωση. Η διαδικασία είναι απλή και προσβάσιμη, ώστε να μπορεί να συμμετέχει οποιοσδήποτε.",
                "Citizens evaluate the accessibility of a point of interest (building, sidewalk, public space), record any obstacles they encounter, and leave comments or suggestions for improvement. The process is simple and accessible, so anyone can participate."
              ) }}
            </p>
          </li>
          <li class="step">
            <span class="step-title">{{ t("Δομή", "Structure") }}</span>
            <p>
              {{ t(
                "Η πλατφόρμα επαληθεύει, κατηγοριοποιεί και αποδίδει επίπεδο πρόσβασης ώστε κάθε σημείο να είναι συγκρίσιμο και χρήσιμο.",
                "The platform verifies, categorizes, and assigns accessibility levels so each point is comparable and useful."
              ) }}
            </p>
          </li>
          <li class="step">
            <span class="step-title">{{ t("Δράση", "Action") }}</span>
            <p>
              {{ t(
                "Οι πολίτες βλέπουν ενημερωμένο χάρτη και πιο ασφαλείς διαδρομές. Όταν ωριμάσουν τα δεδομένα, τα συνθέτουμε σε μορφές που μπορούν να αξιοποιηθούν από συνεργαζόμενους φορείς.",
                "Citizens see an updated map and safer routes. When the data matures, we synthesize it into formats that partners can make use of."
              ) }}
            </p>
          </li>
        </ol>
      </section>

      <section id="partners" aria-labelledby="partners-title">
        <div class="callout">
          <p class="eyebrow">{{ t("Για δήμους", "For cities") }}</p>
          <h2 id="partners-title">
            {{ t("Δεδομένα που στηρίζουν αποφάσεις", "Data that supports decision-making") }}
          </h2>
          <p>
            {{ t(
              "Φτιάχνουμε μια κοινή βάση προσβασιμότητας για να υπάρχει ενιαία εικόνα ανά γειτονιά και σημείο.",
              "We build a shared accessibility base so there is a consistent view by neighborhood and location."
            ) }}
          </p>
          <div class="split">
            <div>
              <h3>{{ t("Κοινό πλαίσιο", "Shared framework") }}</h3>
              <p>
                {{ t(
                  "Σταθερές κατηγορίες και πεδία ώστε όλοι να μιλούν την ίδια γλώσσα.",
                  "Stable categories and fields so everyone speaks the same language."
                ) }}
              </p>
            </div>
            <div>
              <h3>{{ t("Ορατότητα", "Visibility") }}</h3>
              <p>
                {{ t(
                  "Τεκμηριωμένη εικόνα των σημείων που χρειάζονται προσοχή.",
                  "An evidence-based view of the points that need attention."
                ) }}
              </p>
            </div>
          </div>
        </div>
      </section>

      <section id="contact" aria-labelledby="contact-title">
        <p class="eyebrow">{{ t("Συμμετοχή", "Get involved") }}</p>
        <h2 id="contact-title">
          {{ t("Ας σχεδιάσουμε την πόλη όπως τη θέλουμε", "Let’s design the city we want") }}
        </h2>
        <div class="split">
          <div class="card">
            <h3>{{ t("Για πολίτες", "For citizens") }}</h3>
            <p>
              {{ t(
                "Στείλε μας παρατηρήσεις ή ιδέες για συνεργασίες με την κοινότητα.",
                "Send us observations or ideas for community collaboration."
              ) }}
            </p>
          </div>
          <div class="card">
            <h3>{{ t("Για δήμους & φορείς", "For municipalities") }}</h3>
            <p>
              {{ t(
                "Επικοινωνήστε για συνεργασία, πιλοτικές δράσεις ή ανταλλαγή πληροφοριών.",
                "Reach out for collaboration, pilot initiatives, or information exchange."
              ) }}
            </p>
          </div>
        </div>
        <div class="callout spaced">
          <p>{{ t("Email συνεργασίας", "Collaboration email") }}</p>
          <p>
            <a href="mailto:info@accessity.gr">info@accessity.gr</a>
          </p>
        </div>
      </section>
    </main>

    <footer>
      <div class="wrap">
        <span id="copyright"></span>
        <div class="footer-links">
          <a href="#about">{{ t("Σχετικά", "About") }}</a>
          <a href="#how">{{ t("Διαδικασία", "Process") }}</a>
          <a href="#contact">
            {{ t("Επικοινωνία", "Contact") }}
          </a>
          <a href="blog.html">{{ t("Νέα", "News") }}</a>
        </div>
      </div>
    </footer>

    <button
      class="scroll-top"
      id="scroll-top"
      type="button"
      aria-label="Scroll to top"
    >
      <svg
        class="scroll-top__icon"
        viewBox="0 0 24 24"
        role="img"
        aria-hidden="true"
      >
        <path d="M12 6l6 6-1.4 1.4L13 9.8V19h-2V9.8L7.4 13.4 6 12z" />
      </svg>
    </button>

    <script src="{{ rootPrefix }}assets/app.v4.js" defer></script>
  </body>
</html>
