<!doctype html>
<html lang="{{ lang }}">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />

    <title>{{ t(pageTitleEl, pageTitleEn) }}</title>

    <meta
      name="description"
      content="{{ t(pageDescriptionEl, pageDescriptionEn) }}"
    />

    <link rel="icon" href="{{ rootPrefix }}assets/logo.v2.png" type="image/png" />

    {% include "partials/alternates.njk" %}

    <meta name="robots" content="index,follow" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:wght@600;700&family=Source+Sans+3:wght@400;600;700&display=swap"
      rel="stylesheet"
    />

    <meta name="theme-color" content="#3b0db5" />
    <meta name="color-scheme" content="light" />
    <link rel="stylesheet" href="{{ rootPrefix }}assets/styles.v2.css" />
  </head>

  <body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
    <a href="#main" class="skip-link">
      {{ t(site.ui.skipEl, site.ui.skipEn) }}
    </a>

    <header id="top">
      <div class="wrap nav-bar">
        <a class="brand" href="{{ homePrefix }}index.html" aria-label="Accessity">
          <img class="brand-mark" src="{{ rootPrefix }}assets/logo.v2.png" alt="" />
          <span class="brand-text">Accessity</span>
        </a>
        <nav aria-label="Main navigation">
          <a href="{{ homePrefix }}index.html#about">
            {{ t(site.ui.aboutEl, site.ui.aboutEn) }}
          </a>
          <a href="{{ homePrefix }}index.html#how">
            {{ t(site.ui.howEl, site.ui.howEn) }}
          </a>
          <a href="{{ homePrefix }}index.html#partners">
            {{ t(site.ui.citiesEl, site.ui.citiesEn) }}
          </a>
          <a href="{{ homePrefix }}index.html#contact">
            {{ t(site.ui.getInvolvedEl, site.ui.getInvolvedEn) }}
          </a>
          <a
            href="{{ homePrefix }}blog.html"
            {% if navCurrent == "blog" %}aria-current="page"{% endif %}
          >
            {{ t(site.ui.newsEl, site.ui.newsEn) }}
          </a>
        </nav>
        <div class="nav-actions">
          <a class="btn btn-primary" href="{{ homePrefix }}index.html#contact">
            {{ t(site.ui.contactEl, site.ui.contactEn) }}
          </a>
          {% include "partials/lang-switch.njk" %}
        </div>
      </div>
    </header>

    {{ content | safe }}

    <footer>
      <div class="wrap">
        <span id="copyright"></span>
        <div class="footer-links">
          <a href="{{ homePrefix }}index.html#about">
            {{ t(site.ui.footerAboutEl, site.ui.footerAboutEn) }}
          </a>
          <a href="{{ homePrefix }}index.html#how">
            {{ t(site.ui.footerProcessEl, site.ui.footerProcessEn) }}
          </a>
          <a href="{{ homePrefix }}index.html#contact">
            {{ t(site.ui.footerContactEl, site.ui.footerContactEn) }}
          </a>
          <a href="{{ homePrefix }}blog.html">
            {{ t(site.ui.newsEl, site.ui.newsEn) }}
          </a>
        </div>
      </div>
    </footer>

    <button
      class="scroll-top"
      id="scroll-top"
      type="button"
      aria-label="Scroll to top"
    >
      <svg
        class="scroll-top__icon"
        viewBox="0 0 24 24"
        role="img"
        aria-hidden="true"
      >
        <path d="M12 6l6 6-1.4 1.4L13 9.8V19h-2V9.8L7.4 13.4 6 12z" />
      </svg>
    </button>

    <script src="{{ rootPrefix }}assets/app.v4.js" defer></script>
  </body>
</html>
