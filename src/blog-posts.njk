---
layout: layouts/base.njk
pagination:
  data: postPages
  size: 1
  alias: entry
permalink: "{{ 'en/' if entry.lang == 'en' }}blog/{{ entry.post.slug }}.html"
navCurrent: blog
bodyClass: page-post
eleventyComputed:
  lang: "{{ entry.lang }}"
  # Raw on purpose: base.njk escapes these where it outputs them.
  pageTitleEl: "{{ entry.post.seoTitleEl | safe }}"
  pageTitleEn: "{{ entry.post.seoTitleEn | safe }}"
  pageDescriptionEl: "{{ entry.post.seoDescriptionEl | safe }}"
  pageDescriptionEn: "{{ entry.post.seoDescriptionEn | safe }}"
---
{% set post = entry.post -%}
<main id="main" class="wrap post-page" tabindex="-1">
  <a href="../blog.html" class="post-back">
    {{ t(site.ui.backToNewsEl, site.ui.backToNewsEn) }}
  </a>

  <article class="post-article">
    <header class="post-header">
      <div class="post-meta">
        <span class="blog-tag{% if post.tagStyle == 'announcement' %} blog-tag--announcement{% endif %}">
          {{ t(post.categoryEl, post.categoryEn) }}
        </span>
        <time datetime="{{ post.publishDate }}" class="blog-date">
          {{ t(post.dateLabelEl, post.dateLabelEn) }}
        </time>
      </div>
      <h1>{{ t(post.titleEl, post.titleEn) }}</h1>
    </header>

    <div class="post-body">
      {# styles.v2.css sets the first paragraph's margin through [data-lang-block]. #}
      <div data-lang-block="{{ lang }}">{{ t(post.bodyEl, post.bodyEn) | markdown | safe }}</div>
    </div>
  </article>
</main>
